# Copy to .env.local and fill in. Never commit real keys.
#   cp .env.example .env.local
#
# For Vercel: Project → Settings → Environment Variables
#   add MODEL_API_KEY there (Production + Preview). .env.local does NOT deploy.

MODEL_API_KEY=

# muse-spark-1.3 | muse-wonder-1.0
MUSE_MODEL=muse-spark-1.3
MUSE_REASONING_EFFORT=medium

# SAM 3.1 boxes (default on). Set 0 to use Muse-only boxes.
MUSE_USE_SAM=1
